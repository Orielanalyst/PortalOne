# Copy to .env. Never commit .env.
# Server-side only — none of these may be prefixed with VITE_.

# ---- Data: Zetaris -------------------------------------------------------
# Verified local route: UI proxy. Direct REST is an alternative, not the same URL.
ZETARIS_BASE_URL=http://127.0.0.1:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Obtain the numeric org ID from login; do not assume it is 1 on another install.
ZETARIS_ORG_ID=1
# Either an API key, or an existing account username and password.
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_TIMEOUT=60
ZETARIS_QUERY_LIMIT=5

# ---- Power: Meterless Nightshift ----------------------------------------
# The NVIDIA key belongs in Nightshift's Providers tab, never in this file.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_APP=portal-one
