{
  "name": "portal-one",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:world-model": "bun build ./vendor/meterless-world-model/src/index.ts --target=node --format=esm --outdir ./vendor/meterless-world-model/dist && tsc --target ES2022 --module ESNext --moduleResolution Bundler --strict --skipLibCheck --declaration --emitDeclarationOnly --allowImportingTsExtensions --types node --outDir vendor/meterless-world-model/dist vendor/meterless-world-model/src/index.ts",
    "check:world-model": "bun scripts/check-world-model.ts",
    "demo:world-model": "bun scripts/demo-world-model.ts",
    "check:meterless": "bun scripts/check-meterless.ts"
  },
  "dependencies": {
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^20.0.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "vite": "8.1.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
