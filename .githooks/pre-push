#!/bin/sh
set -eu

echo "pre-push: typecheck"
bun run typecheck

echo "pre-push: tests"
bun run test

echo "pre-push: Meterless World Model conformance"
bun run check:world-model

echo "pre-push: vendored archives"
bun run check:vendor

echo "pre-push: offline relief replay with HTTP disabled"
bun run check:offline-replay

echo "pre-push: offline mission investigation with HTTP disabled"
bun run check:mission-replay

echo "pre-push: build"
bun run build
